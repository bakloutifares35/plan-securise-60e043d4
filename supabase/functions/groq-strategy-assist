// supabase/functions/groq-strategy-assist/index.ts

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";

const GROQ_API_KEY = Deno.env.get("GROQ_API_KEY");
const GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Content-Type": "application/json",
};

console.log("🚀 Groq Strategy Assist Function started");

serve(async (req) => {
  // Gestion du preflight OPTIONS
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: corsHeaders });
  }

  try {
    if (!GROQ_API_KEY) {
      return new Response(
        JSON.stringify({ error: "GROQ_API_KEY non configurée." }),
        { status: 500, headers: corsHeaders }
      );
    }

    const { action, context } = await req.json();

    // --- Action 1 : Recommandation automatique d'option ---
    if (action === "recommend") {
      const { processName, criticality, rto, rpo, resources, scenarios, perimetre, hypotheses, options } = context;

      const systemPrompt = `Tu es un expert en continuité d'activité (PCA/BCM). 
Ton rôle est de recommander la meilleure option de stratégie de continuité pour un processus critique donné.
Retourne UNIQUEMENT un JSON valide avec 3 champs : "recommended_option_id", "rationale" (courte phrase en français), "confidence" ("haute", "moyenne" ou "basse").
Ne retourne AUCUN autre texte que le JSON.`;

      const userPrompt = `Contexte du processus :
- Nom : ${processName}
- Criticité BIA : ${criticality}
- RTO : ${rto}h
- RPO : ${rpo}h
- Ressources clés : ${resources || "Aucune ressource spécifique"}
- Scénarios de disruption identifiés : ${scenarios || "Aucun"}
- Périmètre : ${perimetre || "Non défini"}
- Hypothèses et contraintes : ${hypotheses || "Non définies"}

Options de stratégie disponibles (format: ID : Nom - Description) :
${options.map((o: any) => `${o.id} : ${o.nom} - ${o.description || "Option générique"}`).join("\n")}

Quelle option recommandez-vous ? Répondez UNIQUEMENT au format JSON.`;

      const groqResponse = await fetch(GROQ_API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${GROQ_API_KEY}`,
        },
        body: JSON.stringify({
          model: "llama-3.1-8b-instant",
          messages: [
            { role: "system", content: systemPrompt },
            { role: "user", content: userPrompt },
          ],
          temperature: 0.2,
          max_tokens: 500,
        }),
      });

      if (!groqResponse.ok) {
        const errorText = await groqResponse.text();
        return new Response(
          JSON.stringify({ error: `Groq API Error (${groqResponse.status})`, details: errorText }),
          { status: groqResponse.status, headers: corsHeaders }
        );
      }

      const groqData = await groqResponse.json();
      const content = groqData.choices?.[0]?.message?.content || "";

      // Nettoyer le JSON retourné par Groq (il peut ajouter des markdown ```json)
      const jsonContent = content.replace(/```json/g, "").replace(/```/g, "").trim();

      return new Response(
        JSON.stringify({ response: jsonContent }),
        { headers: corsHeaders }
      );
    }

    // --- Action 2 : Génération de la justification ---
    if (action === "justify") {
      const { processName, criticality, rto, rpo, selectedOptionName, selectedOptionDescription } = context;

      const systemPrompt = `Tu es un expert en continuité d'activité (PCA/BCM). 
Rédige une justification professionnelle (2-3 phrases, en français) expliquant pourquoi une option de stratégie a été choisie pour un processus critique.
Ton ton doit être factuel, technique, et adapté à un rapport de BCM.
Ne mentionne pas "en tant qu'IA". Ne commence pas par "Il est important de noter que...".
Retourne UNIQUEMENT la justification, pas de JSON.`;

      const userPrompt = `Contexte du processus :
- Nom : ${processName}
- Criticité : ${criticality}
- RTO : ${rto}h
- RPO : ${rpo}h

Option choisie :
- Nom : ${selectedOptionName}
- Description : ${selectedOptionDescription}

Rédige une justification technique et concise de 2-3 phrases en français.`;

      const groqResponse = await fetch(GROQ_API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${GROQ_API_KEY}`,
        },
        body: JSON.stringify({
          model: "llama-3.1-8b-instant",
          messages: [
            { role: "system", content: systemPrompt },
            { role: "user", content: userPrompt },
          ],
          temperature: 0.2,
          max_tokens: 300,
        }),
      });

      if (!groqResponse.ok) {
        return new Response(
          JSON.stringify({ error: `Groq API Error (${groqResponse.status})` }),
          { status: groqResponse.status, headers: corsHeaders }
        );
      }

      const groqData = await groqResponse.json();
      const justification = groqData.choices?.[0]?.message?.content || "";

      return new Response(
        JSON.stringify({ justification }),
        { headers: corsHeaders }
      );
    }

    return new Response(
      JSON.stringify({ error: "Action invalide. Utilisez 'recommend' ou 'justify'." }),
      { status: 400, headers: corsHeaders }
    );

  } catch (error) {
    console.error("❌ Erreur:", error);
    return new Response(
      JSON.stringify({ error: error.message }),
      { status: 500, headers: corsHeaders }
    );
  }
});